# .env — copiar a .env y ajustar valores reales
APP_ENV=production
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=motorpark
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Sesión: timeout en segundos. SESSION_SECURE=true fuerza cookie solo HTTPS.
SESSION_TIMEOUT=600
SESSION_SECURE=true

# cURL: verificar certificados SSL (true en Hostinger/producción)
CURL_SSL_VERIFY=true

# RBAC: false desactiva verificación de módulos (solo autenticación)
PERMISOS_ENFORCED=true

# Horario permitido para login (Lun-Sáb)
STARTIME=07:30
ENDTIME=19:00
